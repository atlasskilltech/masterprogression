<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" integrity="sha384-zCbKRCUGaJDkqS1kPbPd7TveP5iyJE0EjAuZQTgFLD2ylzuqKfdKlfG/eSrtxUkn" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Maven+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="<%= base_url('assets/admission/css/style.css') %>">
    <link rel="stylesheet" type="text/css" href="<%= base_url('assets/admission/css/font.css') %>">
    <title>Admission Portal</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5FTSFZ9M92"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-5FTSFZ9M92');
    </script>
  </head>
  <body class="main-section">
    <header>
      <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="#"><img src="<%= base_url('assets/admission/images/atlas-logo.png') %>" class="logo-img"></a>
      </nav>
    </header>

    <div>
      <div class="center-div">
        <p class="opt-head">Verification Code</p>
        <p class="otp-para">Enter the 4 digit verification code sent to the <br>Mobile number:
          <span class="otp-highlight">xxxxxx<%= mobileLast4 %></span>
        </p>
        <center>
          <div class="container">
            <div class="row justify-content-md-center">
              <div class="col-md-12 text-center">
                <div class="row">
                  <div class="col-sm-12">
                    <form action="javascript:void(0)" class="mt-5">
                      <input class="otp small-box" type="text" name="otp" placeholder="Enter OTP" onKeyPress="myFunction(event)" maxlength="4" autofocus>
                    </form>
                  </div>
                </div>

                <div class="row otp-btn-row">
                  <div class="btn-gap">
                    <div class="input-group mb-3">
                      <button type="button" class="btn login-back-btn" onClick="window.location.href='<%= base_url('login/verification/chooseMobile') %>'"><img src="<%= base_url('assets/admission/images/back-btn-img.png') %>"></button>
                      <div class="input-group-append">
                        <button type="button" class="btn login-back-btn login-back-txt-btn" onClick="window.location.href='<%= base_url('login/verification/chooseMobile') %>'">Back</button>
                      </div>
                    </div>
                  </div>

                  <div>
                    <div class="input-group mb-3">
                      <button type="button" class="btn verify-btn" onClick="VerificationOTP()">Verify</button>
                      <div class="input-group-append">
                        <button type="button" class="btn app-btn" onClick="VerificationOTP()"><img src="<%= base_url('assets/admission/images/btn-img.png') %>"></button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </center>
      </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script>
      $(document).ready(function () {
        $('input').on('focus keypress', function () {
          $('input').removeClass('error');
          $('input').attr('placeholder', 'Enter OTP');
        });
      });

      function VerificationOTP() {
        var otp = $("input[name='otp']").val();
        $.ajax({
          type: "POST",
          url: "<%= base_url('login/verification/VerificationOTP') %>",
          dataType: "json",
          data: { otp: otp },
          success: function (res) {
            if (res.status == 0) {
              $('input').blur();
              $('input').val('');
              $('input').addClass('error');
              $('input').attr('placeholder', res.msg);
            } else if (res.status == 1) {
              window.location = "<%= base_url('lor') %>";
            }
          }
        });
      }

      function myFunction(e) {
        if (event.which == 13 || event.keyCode == 13) { VerificationOTP(); }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
  </body>
</html>
