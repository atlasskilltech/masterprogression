<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
<%- include('partials/head') %>
  <title>Verify · Choose contact · ATLAS</title>
</head>

<body class="relative min-h-screen bg-slate-50 font-sans text-slate-800 antialiased transition-colors duration-300 dark:bg-slate-950 dark:text-slate-100">

<%- include('partials/background') %>

<header class="relative z-10">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-6 sm:px-6">
<%- include('partials/logo') %>

    <div class="flex items-center gap-3">
      <a href="<%= base_url('login/verification/goBackToApplnStatus') %>"
         class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-medium text-slate-600 backdrop-blur hover:bg-slate-100 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10">
        <i data-lucide="arrow-left" class="h-4 w-4"></i> Back
      </a>
<%- include('partials/theme-toggle') %>
    </div>
  </div>
</header>

<main class="relative z-10 mx-auto max-w-3xl px-4 pb-16 sm:px-6">

  <nav class="mb-10 flex flex-wrap items-center justify-center gap-2 text-xs font-medium">
    <span class="flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1.5 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300"><i data-lucide="check" class="h-3.5 w-3.5"></i>Application</span>
    <span class="h-px w-6 bg-slate-300 dark:bg-white/15"></span>
    <span class="flex items-center gap-2 rounded-full bg-indigo-100 px-3 py-1.5 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-200"><span class="grid h-4 w-4 place-items-center rounded-full bg-indigo-500 text-[10px] text-white">2</span>Choose contact</span>
    <span class="h-px w-6 bg-slate-300 dark:bg-white/15"></span>
    <span class="flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-slate-500 dark:bg-white/5 dark:text-slate-400"><span class="grid h-4 w-4 place-items-center rounded-full bg-slate-200 text-[10px] dark:bg-white/10">3</span>Verify OTP</span>
  </nav>

  <div class="text-center">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Where should we send the code?</h1>
    <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      Pick one of the contacts on your application. We'll send a 4-digit verification code to that mobile number<% if (typeof maskedEmail !== 'undefined' && maskedEmail) { %> and to the email on your application<% } %>.
    </p>
  </div>

<%
  /* card state classes — shared with the JS below so both stay in sync */
  var cardBase = 'group flex w-full items-start gap-4 rounded-2xl border p-5 text-left backdrop-blur transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400';
  var cardOn   = 'border-indigo-500 bg-indigo-50/60 ring-2 ring-indigo-500 dark:bg-indigo-500/15';
  var cardOff  = 'border-slate-200 bg-white hover:border-indigo-400 hover:bg-slate-50 dark:border-white/10 dark:bg-white/[0.04] dark:hover:border-indigo-400/60 dark:hover:bg-white/[0.07]';
  var ringOn   = 'border-indigo-600 bg-indigo-600';
  var ringOff  = 'border-slate-300 bg-transparent dark:border-white/30';
  var labelOn  = 'text-indigo-700 dark:text-indigo-300';
  var labelOff = 'text-slate-500 dark:text-slate-400';

  var applicant = { name: 'Applicant', icon: 'user', recommended: true,
                    wrap: 'bg-gradient-to-br from-indigo-500/15 to-cyan-500/15 dark:from-indigo-500/30 dark:to-cyan-500/30',
                    color: 'text-indigo-600 dark:text-indigo-200' };
  var email = typeof maskedEmail !== 'undefined' ? maskedEmail : '';
  var contacts = {
    master_phone:      applicant,
    appln_phone:       applicant,
    appln_fatherPhone: { name: 'Father', icon: 'user-circle-2',
                         wrap: 'bg-slate-100 dark:bg-white/5', color: 'text-cyan-600 dark:text-cyan-300' },
    appln_motherPhone: { name: 'Mother', icon: 'user-circle-2',
                         wrap: 'bg-slate-100 dark:bg-white/5', color: 'text-fuchsia-600 dark:text-fuchsia-300' }
  };
  var keys = Object.keys(mobiles || {}).filter(function (k) { return mobiles[k]; });
%>

<form action="javascript:void(0)" class="mt-10 space-y-4">
<% if (!keys.length) { %>
  <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-800 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200">
    We couldn't find a mobile number on your application. Please contact
    <a href="mailto:admissions@atlasuniversity.edu.in" class="font-semibold underline">admissions@atlasuniversity.edu.in</a>.
  </div>
<% } %>
<% keys.forEach(function (key, idx) {
     var c = contacts[key] || contacts.appln_fatherPhone;
     var name = contacts[key] ? c.name : 'Contact';
     var val = String(mobiles[key]);
     var isFirst = idx === 0;
%>
  <button type="button" data-contact role="radio" aria-checked="<%= isFirst %>"
    class="<%= cardBase %> <%= isFirst ? cardOn : cardOff %>">

    <input type="radio" name="mobile" id="test<%= idx + 1 %>" value="<%= val %>" class="sr-only" tabindex="-1" <%= isFirst ? 'checked' : '' %> />

    <span data-radio class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full border-2 transition <%= isFirst ? ringOn : ringOff %>">
      <span data-radio-dot class="h-2 w-2 rounded-full bg-white transition <%= isFirst ? '' : 'opacity-0' %>"></span>
    </span>

    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl <%= c.wrap %> <%= c.color %>">
      <i data-lucide="<%= c.icon %>" class="h-5 w-5"></i>
    </span>

    <span class="min-w-0 flex-1">
      <span data-label class="block text-xs font-semibold uppercase tracking-wide <%= isFirst ? labelOn : labelOff %>"><%= name %></span>
      <span class="mt-1 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm text-slate-900 dark:text-white">
        <span class="flex items-center gap-2">
          <i data-lucide="phone" class="h-3.5 w-3.5 text-slate-500 dark:text-slate-400"></i>
          +91 xxxxxx<%= val.slice(-4) %>
        </span>
        <% if (email && c.recommended) { %>
        <span class="flex min-w-0 items-center gap-2">
          <i data-lucide="mail" class="h-3.5 w-3.5 shrink-0 text-slate-500 dark:text-slate-400"></i>
          <span class="truncate"><%= email %></span>
        </span>
        <% } %>
      </span>
    </span>

    <% if (c.recommended) { %>
      <span class="hidden shrink-0 text-xs font-medium text-emerald-600 dark:text-emerald-300 sm:block">Recommended</span>
    <% } %>
  </button>
<% }); %>

  <p id="otpError" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300"></p>

  <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
    <a href="<%= base_url('login/verification/goBackToApplnStatus') %>"
       class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 backdrop-blur transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10">
      <i data-lucide="arrow-left" class="h-4 w-4"></i><span>Back</span>
    </a>

    <button type="button" id="sendOtpBtn" <%= keys.length ? '' : 'disabled' %>
      class="group inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition hover:from-indigo-500 hover:to-cyan-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 disabled:cursor-not-allowed disabled:opacity-60">
      <span id="sendOtpLabel">Send verification code</span>
      <i data-lucide="arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5"></i>
    </button>
  </div>
</form>

</main>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<%- include('partials/theme-script') %>
<script>
(function () {
  var GENERATE_URL = "<%= base_url('login/verification/generateOTP') %>";
  var VERIFY_URL   = "<%= base_url('login/verification/verificationIndex') %>";

  var CARD_ON   = "<%= cardOn %>".split(' ');
  var CARD_OFF  = "<%= cardOff %>".split(' ');
  var RING_ON   = "<%= ringOn %>".split(' ');
  var RING_OFF  = "<%= ringOff %>".split(' ');
  var LABEL_ON  = "<%= labelOn %>".split(' ');
  var LABEL_OFF = "<%= labelOff %>".split(' ');

  var cards    = document.querySelectorAll('[data-contact]');
  var errorEl  = document.getElementById('otpError');
  var btn      = document.getElementById('sendOtpBtn');
  var btnLabel = document.getElementById('sendOtpLabel');

  function swap(el, onList, offList, on) {
    onList.forEach(function (c)  { el.classList.toggle(c, on);  });
    offList.forEach(function (c) { el.classList.toggle(c, !on); });
  }

  function select(card) {
    cards.forEach(function (c) {
      var on = (c === card);
      c.querySelector('input[name="mobile"]').checked = on;
      c.setAttribute('aria-checked', on ? 'true' : 'false');
      swap(c, CARD_ON, CARD_OFF, on);
      swap(c.querySelector('[data-radio]'), RING_ON, RING_OFF, on);
      swap(c.querySelector('[data-label]'), LABEL_ON, LABEL_OFF, on);
      c.querySelector('[data-radio-dot]').classList.toggle('opacity-0', !on);
    });
    setError(false);
  }

  cards.forEach(function (c) {
    c.addEventListener('click', function () { select(c); });
  });

  function setError(on, msg) {
    errorEl.textContent = msg || '';
    errorEl.classList.toggle('hidden', !on);
  }

  function setLoading(on) {
    btn.disabled = on;
    btnLabel.textContent = on ? 'Sending…' : 'Send verification code';
  }

  // Server messages may carry markup (e.g. a font-awesome icon) — show text only.
  function plain(msg) {
    var doc = new DOMParser().parseFromString(String(msg || ''), 'text/html'); // inert document
    return (doc.body.textContent || '').trim();
  }

  window.generateOTP = function () {
    var checked = document.querySelector('input[name="mobile"]:checked');
    if (!checked) {
      setError(true, 'Please choose a contact to receive the code.');
      return;
    }

    setLoading(true);
    setError(false);

    $.ajax({
      type: 'POST',
      url: GENERATE_URL,
      dataType: 'json',
      data: { mobile: checked.value },
      success: function (res) {
        if (res.status == 1) {
          window.location = VERIFY_URL;
        } else {
          setLoading(false);
          setError(true, plain(res.msg) || 'Could not send the code. Please try again.');
        }
      },
      error: function () {
        setLoading(false);
        setError(true, 'Something went wrong. Please try again.');
      }
    });
  };

  btn.addEventListener('click', generateOTP);

  if (window.lucide) lucide.createIcons();
})();
</script>
</body>
</html>
