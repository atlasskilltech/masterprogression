      <div class="appDetailFormSection">
         <div class="container-fluid my-w-85">
            <div class="row">
               <div class="container">
                  <div class="row">
                     <div class="appDetailFormSectionWrapper">
                        <div class="appDetailFormSectionInnerWrap">
                          
                           <div class="row">
                              <form  action="javascript:void(0)" class="appDetailForm">
                                  
                                 
                                 <div class="form-row">
                                    
                                    <div class="form-group col-md-6">
                                       <p class="appDetailFormPara">Countries you have decided</p>
                                       <select class="form-control classic" name="master_apply_counrty" id="master_apply_counrty">
                                          <option value=""  selected>Country</option>
                                          <option value="UK"  >UK</option>
                                          <option value="USA"  >USA</option>
                                          <option value="Canada"  >Canada</option>
                                          <option value="Australia"  >Australia</option>
                                          <option value="New Zealand"  >New Zealand</option>
                                          <option value="Neatherland"  >Neatherland</option>
                                          <option value="France"  >France</option>
                                          <option value="Germany"  >Germany</option>
                                          <option value="Ireland"  >Ireland</option>
                                          <option value="Singapore"  >Singapore</option>
                                          <option value="Other"  >Other</option>
                                           
                                       </select>
                                    </div>
                                    <div id="divid" class="form-group col-md-6" style="display:none;">
                                         <p class="appDetailFormPara">Other Country Name</p>
                                          <input type="text" class="form-control"  name="master_apply_counrty_1" id="master_apply_counrty_1" value="" placeholder="Other">
                                       </div>
                                       
                                       <div class="form-group col-md-12">
                                           <br>
                                           <p class="appDetailFormPara">Universities you have decided on?</p>
                                          <textarea class="form-control" style="font-size: 2rem;" name="master_apply_university" id="master_apply_university" rows="10"></textarea>
                                       </div>
                                       <div class="form-group col-md-6">
                                       <p class="appDetailFormPara">Do you need Letters of Recommendations?</p>
                                       <select class="form-control classic" name="master_lor" id="master_lor">
                                          <option value=""  selected>Select </option>
                                          <option value="Yes"  >Yes</option>
                                          <option value="No"  >No</option>
                                       </select>
                                    </div>
                                    <div id="divid_2" class="form-group col-md-6" style="display:none;">
                                       <p class="appDetailFormPara">Number of Letters of Recommendations?</p>
                                       <select class="form-control classic" name="master_lor_no" id="master_lor_no">
                                          <option value=""  selected>Select </option>
                                          <option value="1"  >1</option>
                                          <option value="2"  >2</option>
                                       </select>
                                    </div>
                                     <div class="form-group col-md-12">
                                      </div>
                                    <div id="divid_1" class="form-group col-md-6" style="display:none;">
                                        <p class="appDetailFormPara">Name(s) of Professor</p>
                                          <input type="text" class="form-control"  name="master_lor_professor_1" id="master_lor_professor_1" value="" placeholder="Professor">
                                     </div>
                                      <div id="divid_3" class="form-group col-md-6" style="display:none;">
                                        <p class="appDetailFormPara">Name(s) of Professor</p>
                                          <input type="text" class="form-control"  name="master_lor_professor_2" id="master_lor_professor_2" value="" placeholder="Professor">
                                     </div>
                                     <div class="form-group col-md-12">
                                      </div>
                                     <div class="form-group col-md-6">
                                       <p class="appDetailFormPara">Do you need Transcript?</p>
                                       <select class="form-control classic" name="master_transcript" id="master_transcript">
                                          <option value=""  selected>Select </option>
                                          <option value="Yes"  >Yes</option>
                                          <option value="No"  >No</option>
                                       </select>
                                    </div>
                                 </div>
                                 
                                
                                 
                                 


                                 
                                 
                              </form>
