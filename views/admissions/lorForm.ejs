      <script>
           function updateForm()
{  


   var myObj={};
      
   var formData=$("form").serializeArray();
   $.each(formData,function(i,form){
      myObj[form.name]=form.value;
   });
   str = JSON.stringify(myObj);
   
   
   
   
   $.ajax
   ({
      type:'POST',
      url:'<%= base_url() %>/demo/save',
      dataType:'json',
      data:myObj,
      success:function(res)
      {
          if(res == 1){
              alert("Save Successful.");
              
              location.reload();
          }
      
      }
   });
   
}
      </script>
      <script>  
        $(document).ready(function(){
            $('#master_apply_counrty').on('change', function() {
              if ( this.value == 'Other')
              {
                $("#divid").show();
              }
              else
              {
                $("#divid").hide();
              }
            });
        });
        </script>
        
        <script>  
        $(document).ready(function(){
            $('#master_lor').on('change', function() {
              if ( this.value == 'Yes')
              {
                //$("#divid_1").show();
                $("#divid_2").show();
              }
              else
              {
                //$("#divid_1").hide();
                $("#divid_2").hide();
              }
            });
        });
        
        $(document).ready(function(){
            $('#master_lor_no').on('change', function() {
              if (this.value == '1')
              {
                $("#divid_1").show();
                $("#divid_3").hide();
                
              }else if(this.value == '2'){
                  $("#divid_1").show();
                  $("#divid_3").show();
              }
              else
              {
                $("#divid_1").hide();
                $("#divid_3").hide();
              }
            });
        });
        
       
        </script>
