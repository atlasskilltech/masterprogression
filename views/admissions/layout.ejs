<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" integrity="sha384-zCbKRCUGaJDkqS1kPbPd7TveP5iyJE0EjAuZQTgFLD2ylzuqKfdKlfG/eSrtxUkn" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Maven+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="<%= base_url('assets/admissions-assets/common-css/style.css') %>">
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <title>Admission Portal</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5FTSFZ9M92"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-5FTSFZ9M92');
    </script>
  </head>
  <body>
    <!-- top nav -->
    <nav class="navbar navbar-expand-lg navbar-bg">
      <div class="brandGroup">
        <div></div>
        <div>
          <a class="navbar-brand logo-img" href="<%= base_url('lor') %>"><img src="https://atlasskilltech.app/brand/images/atlas-fill.svg"></a>
        </div>
      </div>
      <div class="right-section">
        <div class="profile-section">
          <div class="profile-detail">
            <p class="admit-app-no"> Name : <%= basicDetails.name %></p>
            <p class="admit-id-no"> ID : <%= basicDetails.applnID %></p>
          </div>
        </div>
        <div class="user-section"></div>
      </div>
    </nav>

    <!-- sidebar -->
    <div id="mySidenav" class="sidenav" style="width:0px;">
      <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">&times;</a>
      <a <% if (status > 0) { %> href="<%= base_url('view/formSubmit') %>" <% } else if (status == 1) { %> href="<%= base_url('lor') %>" <% } else { %> href="#" <% } %>><div class="sideItem"><img src="<%= base_url('assets/admissions-assets/images/result.png') %>" alt="" class="sideBarIcon">Application Submitted</div></a>
      <a <% if (status > 3) { %> href="<%= base_url('view/lorApproved') %>" <% } else if (status == 3) { %> href="<%= base_url('lor') %>" <% } else { %> href="#" <% } %>><div class="sideItem"><img src="<%= base_url('assets/admissions-assets/images/result.png') %>" alt="" class="sideBarIcon">LoR Details</div></a>
      <a <% if (status > 5) { %> href="<%= base_url('view/paymentSuccess') %>" <% } else if (status == 4) { %> href="<%= base_url('lor') %>" <% } else { %> href="#" <% } %>><div class="sideItem"><img src="<%= base_url('assets/admissions-assets/images/result.png') %>" alt="" class="sideBarIcon">Fee Payment</div></a>
      <a href="<%= base_url('lor') %>"><div class="sideItem"><img src="<%= base_url('assets/admissions-assets/images/result.png') %>" alt="" class="sideBarIcon">Transcript + LoR</div></a>
      <a href="<%= base_url('dashboard/logout') %>"><div class="logoutBtn"><img src="<%= base_url('assets/admissions-assets/images/logoutIcon.png') %>" alt="" class="sideBarLogoutIcon">Log Out</div></a>
    </div>

    <!-- progress header -->
    <%- include('partials/header') %>

    <!-- page content -->
    <%- body %>

    <script>
      function openNav() { document.getElementById("mySidenav").style.width = "341px"; }
      function closeNav() { document.getElementById("mySidenav").style.width = "0"; }
    </script>

    <div class="upload-loader" id="loading" style="display:none;">
      <img src="<%= base_url('assets/new-ui/images/icons/loading.gif') %>" alt="">
    </div>
    <style>
      .upload-loader { position: fixed; top: 0; left: 0; right: 0; width: 100vw; height: 100vh;
        display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
        flex-direction: column; background: rgba(255,255,255,0.95); z-index: 99999; }
      .upload-loader h5 { font-weight: 400; font-size: 1.7rem; color: #415072; text-align: center; line-height: 2.5rem; margin: 10px 0 0; width: 100%; }
      .error_msg { font-size: 1.4rem; }
    </style>
  </body>
</html>
