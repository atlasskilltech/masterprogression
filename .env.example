# ---- App ----
PORT=3000
# Base path the app is served under. Local: leave blank. Prod (sub-folder): /masterprogression
BASE_URL=
SESSION_SECRET=change-this-to-a-long-random-string

# ---- MySQL (your existing "diceapp" database) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=diceapp

# ---- OTP / SMS (MSG91) ----
# SMS_PROVIDER: msg91 = send for real, stub = print the OTP to the console (local dev).
SMS_PROVIDER=msg91
# Either name works: MSG91_AUTH_KEY or MSG91_AUTHKEY / MSG91_TEMPLATE_OTP or MSG91_TEMPLATE_ID
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=616d0ca2046ee1468139f0a7

# A fixed OTP that always passes, for testing. Set blank to disable.
TEST_OTP=7879

# ---- WhatsApp (WATI) ----
WATI_BASE_URL=https://live-mt-server.wati.io/307724
WATI_TOKEN=
WATI_TEMPLATE_NAME=otp_login_app

# ---- Razorpay (official Node SDK) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (SendGrid SMTP) — used for the login OTP email and payment receipts ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
# SendGrid API key (starts with SG.). SENDGRID_API_KEY is accepted as an alias.
SMTP_PASS=
# Must be a verified Sender / authenticated domain in SendGrid. MAIL_FROM is accepted as an alias.
EMAIL_FROM=masterprogression@atlasuniversity.edu.in
MAIL_FROM_NAME=ATLAS Master Progression

# ---- External DICE fee API (semester module) ----
DICE_FEE_API_BASE=http://diceapp.in/dice/api/fee
