# ---- App ----
PORT=3000
# Base path the app is served under. Local: leave blank. Prod (sub-folder): /masterprogression
BASE_URL=
SESSION_SECRET=change-this-to-a-long-random-string

# ---- MySQL (your existing "diceapp" database) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=diceapp

# ---- OTP / SMS (MSG91) ----
# Leave MSG91_AUTHKEY blank in local dev -> the OTP is printed to the server console instead of being sent.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=616d0ca2046ee1468139f0a7

# A fixed OTP that always passes, for testing. Set blank to disable.
TEST_OTP=7879

# ---- WhatsApp (WATI) ----
WATI_BASE_URL=https://live-mt-server.wati.io/307724
WATI_TOKEN=
WATI_TEMPLATE_NAME=otp_login_app

# ---- Razorpay (official Node SDK) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (SendGrid SMTP) ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=masterprogression@atlasuniversity.edu.in
MAIL_FROM_NAME=ATLAS Master Progression

# ---- External DICE fee API (semester module) ----
DICE_FEE_API_BASE=http://diceapp.in/dice/api/fee
